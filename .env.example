# Shared
APP_ENV=development

# PostgreSQL
POSTGRES_DB=f1intelligence
POSTGRES_USER=f1
POSTGRES_PASSWORD=f1
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+asyncpg://f1:f1@localhost:5433/f1intelligence

# Redis
REDIS_HOST_PORT=6379
REDIS_URL=redis://localhost:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Media
MEDIA_STORAGE_BACKEND=local
MEDIA_STORAGE_PATH=.data/media
# Optional Cloudflare R2 configuration. Leave unset until binary storage is enabled.
MEDIA_R2_ACCOUNT_ID=
MEDIA_R2_ACCESS_KEY_ID=
MEDIA_R2_SECRET_ACCESS_KEY=
MEDIA_R2_PRIVATE_BUCKET=
MEDIA_R2_PUBLIC_BUCKET=
MEDIA_R2_PUBLIC_BASE_URL=
WIKIMEDIA_USER_AGENT=F1Intelligence/0.1 (development; replace-with-contact-before-production)

# Source ingestion
SOURCE_USER_AGENT=F1Intelligence/0.1 (development; replace-with-contact-before-production)
SOURCE_HTTP_CONNECT_TIMEOUT_SECONDS=10
SOURCE_HTTP_READ_TIMEOUT_SECONDS=90
SOURCE_HTTP_RETRIES=3
SOURCE_HTTP_RETRY_BACKOFF_SECONDS=2
EDITORIAL_SOURCE_MIN_INTERVAL_SECONDS=0.5
FIA_PRESS_RELEASE_FEED_URL=https://www.fia.com/rss/press-release
FIA_DOCUMENTS_SEASON_URL=https://www.fia.com/documents/championships/fia-formula-one-world-championship-14/season/season-2026-2072
FORMULA1_LATEST_URL=https://www.formula1.com/en/latest

# OpenF1 historical/research ingestion. 2.1s keeps sustained traffic below the
# documented free-tier 30 requests/minute. Review licensing before commercial use.
OPENF1_MIN_INTERVAL_SECONDS=2.1
